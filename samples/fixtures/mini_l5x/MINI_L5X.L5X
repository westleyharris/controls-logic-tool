<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="DelayOn" Revision="1.0" Vendor="Test" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Description><![CDATA[On-delay a bit]]></Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="In" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Signal to delay]]></Description></Parameter>
<Parameter Name="DelayMs" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"/>
<Parameter Name="Out" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Delayed output]]></Description></Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Tmr" DataType="TIMER" ExternalAccess="None"><Description><![CDATA[Delay timer]]></Description><DefaultData Format="L5K"><![CDATA[[0,0,0]]]></DefaultData></LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[MOV(DelayMs,Tmr.PRE);]]></Text></Rung>
<Rung Number="1" Type="N"><Comment><![CDATA[Time the input]]></Comment><Text><![CDATA[XIC(In)TON(Tmr,?,?);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[XIC(Tmr.DN)OTE(Out);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
<Tags>
<Tag Name="Conveyor" TagType="Base" DataType="Motor_UDT" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Infeed conveyor]]></Description>
<Comments><Comment Operand=".SPEED"><![CDATA[Infeed conveyor speed]]></Comment></Comments>
<Data Format="L5K"><![CDATA[[1,4.50000000e+001]]]></Data>
<Data Format="Decorated"><Structure DataType="Motor_UDT"><DataValueMember Name="Run" DataType="BOOL" Value="1"/><DataValueMember Name="Fault" DataType="BOOL" Value="0"/><DataValueMember Name="Speed" DataType="REAL" Radix="Float" Value="45.0"/></Structure></Data>
</Tag>
<Tag Name="StartPB" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.0" ExternalAccess="Read/Write"><Description><![CDATA[Start push button]]></Description></Tag>
<Tag Name="StopPB" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.1" ExternalAccess="Read/Write"><Description><![CDATA[Stop push button (NC)]]></Description></Tag>
<Tag Name="MotorStarter" TagType="Alias" Radix="Decimal" AliasFor="Local:2:O.Data.0" ExternalAccess="Read/Write"><Description><![CDATA[Conveyor motor starter]]></Description></Tag>
<Tag Name="RunDelay" TagType="Base" DataType="DelayOn" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K"><![CDATA[[7,2000,[-1610612736,2000,2000]]]]></Data>
</Tag>
<Tag Name="Recipe" TagType="Base" DataType="DINT" Dimensions="4" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="Decorated"><Array DataType="DINT" Dimensions="4" Radix="Decimal"><Element Index="[0]" Value="10"/><Element Index="[1]" Value="20"/><Element Index="[2]" Value="30"/><Element Index="[3]" Value="40"/></Array></Data>
</Tag>
</Tags>
<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Description><![CDATA[Conveyor control]]></Description>
<Tags>
<Tag Name="SealIn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Run seal-in]]></Description><Data Format="L5K"><![CDATA[1]]></Data></Tag>
</Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Start / stop seal-in]]></Comment><Text><![CDATA[[XIC(StartPB) ,XIC(SealIn) ]XIC(StopPB)XIO(Conveyor.Fault)OTE(SealIn);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[DelayOn(RunDelay,SealIn,2000)XIC(RunDelay.Out)OTE(MotorStarter)OTE(Conveyor.Run);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[JSR(Speeds,0);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Speeds" Type="ST">
<STContent>
<Line Number="0"><![CDATA[// Pick the speed from the recipe]]></Line>
<Line Number="1"><![CDATA[IF Conveyor.Run THEN Conveyor.Speed := Recipe[1]; END_IF;]]></Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms><ScheduledProgram Name="MainProgram"/></ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
